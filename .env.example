# Copy this file to .env.local and fill in your own key.
# Get a key at https://console.anthropic.com/

# Required — server-side only, never exposed to the client.
ANTHROPIC_API_KEY = 
# Optional — defaults to Anthropic's fastest/cheapest current model when unset.
# All agent calls read this env var; nothing hardcodes a model string.
CLAUDE_MODEL=claude-haiku-4-5
